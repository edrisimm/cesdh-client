# ── Energy Systems Data Hub — Remote Trial Configuration ─────────────
# Copy this file to .env in your working directory.
# The cesdh SDK auto-loads .env when LAKEFS_ACCESS_KEY_ID is not already
# set in the environment.

# Gateway endpoint (the SDK reads this at import time)
CESDH_DATA_HUB_ENDPOINT=https://fen-esdh.ch

# LakeFS credentials (shared — provided by your esdh manager)
LAKEFS_ACCESS_KEY_ID=<ask-esdh-manager>
LAKEFS_SECRET_ACCESS_KEY=<ask-esdh-manager>

# Optional: LakeFS UI URL used by some example scripts
LAKEFS_URL=https://lakefs.fen-esdh.ch
